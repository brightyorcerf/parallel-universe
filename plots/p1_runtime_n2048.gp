# generated by plots/plot_all.sh -- regenerate, do not hand-edit
set terminal pngcairo size 1000,680 enhanced font 'Helvetica,12'
set output 'plots/p1_runtime_n2048.png'
set title "Problem 1: A^2 runtime, N = 2048"
set xlabel 'Number of OpenMP threads'
set ylabel 'Average runtime (s, log scale)'
set key outside right top
set grid
set xtics (1,2,4,6,8,10,12,14,16)
set logscale y
plot 'plots/data/p1_omm_n2048.dat' using 1:2 with linespoints lw 2 pt 7 title 'OMM (unblocked)', \
     'plots/data/p1_bmm_n2048_b4.dat' using 1:2 with linespoints lw 2 pt 7 title 'BMM block 4', \
     'plots/data/p1_bmm_n2048_b8.dat' using 1:2 with linespoints lw 2 pt 7 title 'BMM block 8', \
     'plots/data/p1_bmm_n2048_b16.dat' using 1:2 with linespoints lw 2 pt 7 title 'BMM block 16', \
     'plots/data/p1_bmm_n2048_b32.dat' using 1:2 with linespoints lw 2 pt 7 title 'BMM block 32', \
     'plots/data/p1_bmm_n2048_b64.dat' using 1:2 with linespoints lw 2 pt 7 title 'BMM block 64'
