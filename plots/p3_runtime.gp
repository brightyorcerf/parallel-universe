# generated by plots/plot_all.sh -- regenerate, do not hand-edit
set terminal pngcairo size 1000,680 enhanced font 'Helvetica,12'
set output 'plots/p3_runtime.png'
set title "Problem 3: sorting runtime"
set xlabel 'Number of OpenMP threads'
set ylabel 'Average runtime (s, log scale)'
set key outside right top
set grid
set xtics (1,2,4,6,8,10,12,14,16)
set logscale y
plot 'plots/data/p3_counting_n5000000.dat' using 1:2 with linespoints lw 2 pt 7 title 'counting sort', \
     'plots/data/p3_merge_n5000000.dat' using 1:2 with linespoints lw 2 pt 7 title 'parallel merge sort'
